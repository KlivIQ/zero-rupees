{
  "expo": {
    "name": "ZeroRupees",
    "slug": "zero-rupees",
    "version": "1.0.0",
    "scheme": "zerorupees",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zeroapees.app",
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "com.zeroapees.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#000000"
      }
    }
  }
}
